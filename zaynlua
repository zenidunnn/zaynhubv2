local function saveCheckpoint(slot)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then CheckpointSlots[slot] = rootPart.CFrame return true end
    return false
end

local function teleportToCheckpoint(slot)
    if not CheckpointSlots[slot] then
        WindUI:Notify({ Title = "Checkpoint", Content = "Slot " .. slot .. " masih kosong.", Duration = 3 })
        return
    end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then rootPart.CFrame = CheckpointSlots[slot] end
end

local function deleteCheckpoint(slot)
    CheckpointSlots[slot] = nil
    if AutoTeleportSlot == slot then AutoTeleportSlot = nil AutoTeleportOnRespawn = false end
end

track(LocalPlayer.CharacterAdded:Connect(function(character)
    if AutoTeleportOnRespawn and AutoTeleportSlot and CheckpointSlots[AutoTeleportSlot] then
        local rootPart = character:WaitForChild("HumanoidRootPart")
        task.wait(0.5)
        rootPart.CFrame = CheckpointSlots[AutoTeleportSlot]
    end
end))

