local AllDropdowns = {}
local function registerDropdown(dropdown)
    table.insert(AllDropdowns, dropdown)
    return dropdown
end

local function closeAllDropdowns()
    for _, dropdown in ipairs(AllDropdowns) do
        pcall(function() dropdown:Close() end)
    end
end

local function toggleWindowVisibility()
    closeAllDropdowns()

    local ok = pcall(function() Window:Toggle() end)
    if not ok then
        ok = pcall(function() Window:ToggleVisibility() end)
    end
    if not ok then
        pcall(function()
            if Window.Visible then
                Window:Close()
            else
                Window:Open()
            end
        end)
    end
end

local ToggleUIKeybind = Enum.KeyCode.R

