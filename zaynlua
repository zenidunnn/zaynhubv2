    Title = "🔥 Turbo Dig (Master Switch)",
    Value = false,
    Callback = function(Value)
        turboDigEnabled = Value

        if turboDigLoop then
            turboDigLoop:Disconnect()
            turboDigLoop = nil
        end

        if turboDigEnabled and DigEvent then
            local fastEvent = DigEvent
            local fastMouse = LocalPlayer:GetMouse()
            local fastUis = UserInputService
            local localPlayer = LocalPlayer
            local mouseLeft = Enum.UserInputType.MouseButton1

            turboDigLoop = track(RunService.Heartbeat:Connect(function()
                if autoDigNoClick or fastUis:IsMouseButtonPressed(mouseLeft) then
                    local character = localPlayer.Character
                    local currentTool = character and character:FindFirstChildOfClass("Tool")

                    if autoDigNoClick and not currentTool then return end

                    local dynamicItemName = currentTool and currentTool.Name or "Celestial Apex"
                    local targetPos = autoAimBoulder and GetNearestBoulderPosition() or (fastMouse.Hit and fastMouse.Hit.Position)

                    if targetPos then
                        fastEvent:FireServer(dynamicItemName, targetPos)
                    end
                end
            end))
        end
    end
})

