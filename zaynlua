if _G.AdminPanelCleanup then
    pcall(_G.AdminPanelCleanup)
end

local ActiveConnections = {}

local function track(connection)
    table.insert(ActiveConnections, connection)
    return connection
end

_G.AdminPanelCleanup = function()
    for _, conn in ipairs(ActiveConnections) do
        pcall(function() conn:Disconnect() end)
    end
    ActiveConnections = {}

    pcall(function()
        if _G.AdminPanelStopFly then _G.AdminPanelStopFly() end
        if _G.AdminPanelStopNoclip then _G.AdminPanelStopNoclip() end
        if _G.AdminPanelStopESP then _G.AdminPanelStopESP() end
        if _G.AdminPanelClearBoulders then _G.AdminPanelClearBoulders() end
    end)

    -- Menutup Window lama agar tidak duplikat saat dire-execute
    pcall(function()
        local oldWindow = _G.AdminPanelWindow
        if oldWindow then
            local closed = pcall(function() oldWindow:Destroy() end)
            if not closed then closed = pcall(function() oldWindow:Close() end) end
            if not closed then closed = pcall(function() oldWindow:Unload() end) end
        end
    end)

    -- Membersihkan ScreenGui WindUI dari CoreGui/PlayerGui
    pcall(function()
        local containers = { game:GetService("CoreGui") }
        if LocalPlayer:FindFirstChild("PlayerGui") then
            table.insert(containers, LocalPlayer.PlayerGui)
        end
        for _, container in ipairs(containers) do
            for _, gui in ipairs(container:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name:lower():find("windui") then
                    gui:Destroy()
                end
            end
        end
    end)
end

