-- INSTANT PROMPT & AUTO COLLECT LOGIC
----------------------------------------------------

local function triggerPrompt(prompt)
    if not prompt or not prompt.Enabled then return end
    
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local parentPart = prompt.Parent
    local promptPos = parentPart and (parentPart:IsA("BasePart") and parentPart.Position or parentPart:IsA("Model") and parentPart:GetPivot().Position)

    if promptPos then
        local distance = (hrp.Position - promptPos).Magnitude
        if distance <= MaxCollectDistance then
            prompt.HoldDuration = 0
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                pcall(function()
                    prompt:InputHoldBegan()
                    prompt:InputHoldEnd()
                end)
            end
        end
    end
end

local function toggleAutoCollect(state)
    autoCollectEnabled = state

    if autoCollectLoop then
        autoCollectLoop:Disconnect()
        autoCollectLoop = nil
    end

    if autoCollectEnabled then
        autoCollectLoop = track(RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local overlapParams = OverlapParams.new()
            overlapParams.FilterType = Enum.RaycastFilterType.Include
            overlapParams.FilterDescendantsInstances = {workspace}

            local nearbyParts = workspace:GetPartBoundsInRadius(hrp.Position, MaxCollectDistance, overlapParams)

            for _, part in ipairs(nearbyParts) do
                if not autoCollectEnabled then break end
                
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("ProximityPrompt") and child.Enabled then
                        triggerPrompt(child)
                    end
                end
            end
        end))
    end
end

track(ProximityPromptService.PromptShown:Connect(function(prompt)
    if instantPromptEnabled or autoCollectEnabled then
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local parentPart = prompt.Parent
        local promptPos = parentPart and (parentPart:IsA("BasePart") and parentPart.Position or parentPart:IsA("Model") and parentPart:GetPivot().Position)

        if promptPos and (hrp.Position - promptPos).Magnitude <= MaxCollectDistance then
            prompt.HoldDuration = 0
            if autoCollectEnabled then
                triggerPrompt(prompt)
            end
        end
    end
end))

track(ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if instantPromptEnabled or autoCollectEnabled then pcall(function() prompt:InputHoldEnd() end) end
end))

track(UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if gameProcessedEvent then return end
    if autoCollectKeybind and input.KeyCode == autoCollectKeybind then
        local newState = not autoCollectEnabled
        toggleAutoCollect(newState)
        if AutoCollectToggleRef and AutoCollectToggleRef.Set then 
            AutoCollectToggleRef:Set(newState) 
        end
    end
end))

